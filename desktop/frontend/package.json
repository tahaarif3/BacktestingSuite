{
  "name": "backtesting-suite-desktop",
  "version": "1.4.0",
  "description": "Interactive desktop app for the SPY event-driven BacktestingSuite",
  "author": "BacktestingSuite",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "plotly.js-dist-min": "^2.35.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.backtestingsuite.desktop",
    "productName": "BacktestingSuite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/BacktestApiServer",
        "to": "backend"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tahaarif3",
        "repo": "BacktestingSuite",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BacktestingSuite-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "BacktestingSuite"
    }
  }
}
